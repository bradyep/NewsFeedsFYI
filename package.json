{
  "name": "newsfeedsfyi",
  "version": "1.1.0",
  "description": "All your news, at a glance!",
  "private": true,
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "npm run build:prod",
    "build-server": "tsc -p tsconfig.server.json",
    "startbackend": "node dist/server/server.js",
    "startbackendwindows": "set SEQUELIZE_CONNECT=src/server/sequelize/sequelize-sqlite.yaml&& node dist/server/server.js",
    "startbackendwindowsdebug": "set SEQUELIZE_CONNECT=src/server/sequelize/sequelize-sqlite.yaml&& set DEBUG=nffyi-rest:*&& node dist/server/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:client": "jest --selectProjects client",
    "test:server": "jest --selectProjects server",
    "test:common": "jest --selectProjects common",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm run test && npm run test:e2e",
    "docker": "node ./bin/www",
    "startclient": "webpack serve --mode development --history-api-fallback --progress --port 3030 --open",
    "startclient:debug-layout": "set DEBUG_LAYOUT=true&& webpack serve --mode development --history-api-fallback --progress --port 3030 --open",
    "buildclient": "set NODE_ENV=production&& webpack --mode=production --progress",
    "build:prod": "npm run build-server && webpack --mode=production --progress"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bradyep/NewsFeedsFYI.git"
  },
  "keywords": [
    "news",
    "feeds",
    "reader",
    "start",
    "page"
  ],
  "author": "Brady Prigge/Syntonic Studios",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/bradyep/NewsFeedsFYI/issues"
  },
  "homepage": "https://github.com/bradyep/NewsFeedsFYI#readme",
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/classnames": "^2.3.4",
    "@types/cookie-parser": "^1.4.9",
    "@types/debug": "^4.1.12",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.8",
    "@types/feedparser": "^2.2.8",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/morgan": "^1.9.7",
    "@types/node": "^20.11.30",
    "@types/passport": "^1.0.13",
    "@types/passport-local": "^1.0.36",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.17",
    "@types/request": "^2.48.12",
    "@types/sequelize": "^4.28.17",
    "@types/serve-favicon": "^2.5.7",
    "@types/sqlite3": "^3.1.8",
    "@types/supertest": "^6.0.3",
    "@types/webpack": "^5.28.5",
    "css-loader": "^6.8.1",
    "file-loader": "^6.2.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.5.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "mini-css-extract-plugin": "^2.9.2",
    "playwright": "^1.54.2",
    "postcss": "^8.4.38",
    "postcss-browser-reporter": "^0.7.0",
    "postcss-import": "^16.1.1",
    "postcss-loader": "^7.3.3",
    "postcss-url": "^10.1.3",
    "style-loader": "^3.3.4",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-loader": "^9.5.2",
    "typescript": "^5.4.5",
    "url-loader": "^4.1.1",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "dependencies": {
    "body-parser": "^1.20.2",
    "bootstrap": "^5.3.7",
    "classnames": "^2.3.2",
    "cookie-parser": "^1.4.6",
    "copy-webpack-plugin": "^12.0.2",
    "debug": "^4.3.4",
    "express": "^4.19.2",
    "express-session": "^1.17.3",
    "feedparser": "^2.2.10",
    "font-awesome": "^4.7.0",
    "fs-extra": "^11.2.0",
    "js-yaml": "^4.1.0",
    "mobx": "^6.13.0",
    "mobx-react": "^7.6.0",
    "module-alias": "^2.2.3",
    "morgan": "^1.10.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "react": "^18.2.0",
    "react-bootstrap": "^2.10.2",
    "react-dom": "^18.2.0",
    "request": "^2.88.2",
    "sequelize": "^6.37.1",
    "serve-favicon": "^2.5.0",
    "sqlite3": "^5.1.7"
  },
  "_moduleAliases": {
    "server": "dist/server",
    "common": "dist/common",
    "client": "dist/client"
  }
}
