{
    "compilerOptions": {
        "skipLibCheck": true,
        "module": "commonjs",
        "moduleResolution": "bundler",
        "sourceMap": true,
        "allowJs": false,
        "target": "es2015",
        "alwaysStrict": true,
        "declaration": false,
        "strict": true,
        "noImplicitReturns": true,
        "removeComments": true,
        "esModuleInterop": true,
        "useDefineForClassFields": true,
        "jsx": "react",
        "paths": {
            "common/*": ["./src/common/*"],
            "server/*": ["./src/server/*"],
            "client/*": ["./src/client/*"]
        },
        "types": ["node"],
        "outDir": "build",
        "lib": [
          "es6",
          "es7",
          "dom"
        ]
    },
    "exclude": [
        "node_modules",
        "bower_components",
        "**/*.spec.ts",
        "**/*.test.ts",
        "**/*.test.tsx",
        "src/test/**/*",
        "dist",
        "build",
    ]
}
