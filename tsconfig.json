{
    "compilerOptions": {
        "skipLibCheck": true,
        "module": "commonjs",
        "moduleResolution": "node",
        "sourceMap": true,
        "allowJs": false,
        "target": "es2015",
        "alwaysStrict": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "declaration": false,
        "noImplicitAny": true,
        "noImplicitReturns": true,
        "removeComments": true,
        "strictNullChecks": true,
        "esModuleInterop": true,
        "jsx": "react",
        "baseUrl": "src",
        "outDir": "build",
        "lib": [
          "es6",
          "es7",
          "dom"
        ]
    },
    "exclude": [
        "node_modules",
        "bower_components",
        "**/*.spec.ts",
        "dist",
        "build",
    ]
}
