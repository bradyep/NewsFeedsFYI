{
  // Use IntelliSense to learn about possible Node.js debug attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
  
    {
      "type": "node",
      "request": "launch",
      "name": "Launch Program",
      // "program": "${workspaceRoot}\\index.js",
      "program": "${workspaceRoot}/bin/www",
      "cwd": "${workspaceRoot}",
      "sourceMaps": true,
      "env": {
        "SEQUELIZE_CONNECT": "sequelize/sequelize-sqlite.yaml",
        // "DEBUG": "nffyi-rest:*",
        "DEBUG": "nffyi-rest:router-userFeeds,nffyi-rest:error,nffyi-rest:userFeeds-model",
        "PORT": "3000"
      }
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Attach to Process",
      "port": 5858
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Debug Backend Server",
      "port": 9229,
      "localRoot": "${workspaceFolder}",
      "remoteRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Backend (Launch)",
      "program": "${workspaceFolder}/dist/server/server.js",
      "cwd": "${workspaceFolder}",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "env": {
        "SEQUELIZE_CONNECT": "src/server/sequelize/sequelize-sqlite.yaml",
        "DEBUG": "nffyi-rest:*"
      },
      "preLaunchTask": "Build Server"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Launch Chrome against localhost",
      "url": "http://localhost:3030",
      "sourceMaps": true,
      "webRoot": "${workspaceRoot}/src"
    }
  ]
}
