{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "command": "tsc",
  "args": [
    "-p",
    "."
  ],
  "problemMatcher": "$tsc",
  "isBackground": true,
  "tasks": [
    {
      "label": "tsc",
      "type": "shell",
      "command": "tsc",
      "args": [
        "-p",
        "."
      ],
      "isBackground": true,
      "problemMatcher": "$tsc",
      "group": {
        "_id": "build",
        "isDefault": false
      }
    },
    {
      "label": "Start Backend",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build-server", "&&", "npm", "run", "startbackendwindowsdebug"],
      "isBackground": true,
      "problemMatcher": ["$tsc"],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "Build Server",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build-server"],
      "isBackground": false,
      "problemMatcher": ["$tsc"],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "Start Client",
      "type": "shell",
      "command": "npm",
      "args": ["run", "startclient"],
      "isBackground": true,
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "Debug Backend",
      "type": "shell",
      "command": "node",
      "args": ["--inspect=9229", "dist/server/server.js"],
      "isBackground": true,
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "options": {
        "env": {
          "SEQUELIZE_CONNECT": "src/server/models/sequelize-sqlite.yaml"
        }
      }
    }
  ]
}
