# Copy this file to .env and fill in real values for local development.
# Generate strong random secrets, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Secret used to sign JWT session tokens. Required in production.
JWT_SECRET=changeme-generate-a-long-random-string

# Secret used by the CSRF double-submit-cookie middleware. Required in production.
CSRF_SECRET=changeme-generate-a-different-long-random-string

# Number of days a login session (JWT + cookie) remains valid.
JWT_EXPIRY_DAYS=30

# Comma-separated list of origins allowed to make credentialed requests to the API.
CORS_ORIGIN=http://localhost:3030

NODE_ENV=development
