{
    "compilerOptions": {
        "skipLibCheck": true,
        "module": "commonjs",
        "moduleResolution": "node",
        "sourceMap": true,
        "allowJs": true,
        "target": "es2015",
        "alwaysStrict": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "declaration": false,
        "noImplicitAny": false,
        "noImplicitReturns": true,
        "removeComments": true,
        "strictNullChecks": false,
        "esModuleInterop": true,
        "baseUrl": ".",
        "outDir": "dist",
        "paths": {
            "common/*": ["src/common/*"],
            "server/*": ["src/server/*"],
            "client/*": ["src/client/*"]
        },
        "typeRoots": [
            "./node_modules/@types",
            "./types"
        ],
        "lib": [
          "es6",
          "es7"
        ]
    },
    "ts-node": {
        "transpileOnly": true,
        "files": true,
        "compilerOptions": {
            "resolveJsonModule": true
        }
    },
    "include": [
        "src/server/**/*.ts",
        "src/common/**/*.ts",
        "types/**/*.d.ts"
    ],
    "exclude": [
        "node_modules",
        "**/*.spec.ts"
    ]
}
