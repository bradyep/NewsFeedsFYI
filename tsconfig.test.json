{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "paths": {
            "client/*": ["./src/client/*"],
            "common/*": ["./src/common/*"],
            "server/*": ["./src/server/*"]
        },
        "types": ["jest", "@types/testing-library__jest-dom", "node"],
        "typeRoots": ["./types", "./node_modules/@types"],
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "jsx": "react-jsx"
    },
    "include": [
        "src/test/**/*",
        "src/client/**/*",
        "src/common/**/*",
        "src/server/**/*",
        "types/**/*"
    ],
    "exclude": [
        "node_modules",
        "src/test/e2e/**/*"
    ]
}
